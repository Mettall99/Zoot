<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surfaceBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <com.google.android.material.card.MaterialCardView android:id="@+id/errorCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardBackgroundColor="@color/errorBackground"><TextView android:id="@+id/errorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/errorText"/></com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/startContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="Zooot VPN" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Вставьте ссылку подключения, которую вы получили после оплаты." android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/linkInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/linkInput" android:hint="zoootconf://..." android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/continueButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Продолжить"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/serverSelectionContainer" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="Выберите сервер" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:id="@+id/serversList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/selectServerButton" android:text="Выбрать сервер" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/connectionContainer" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="Подключение" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:id="@+id/protocolsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/connectButton" android:text="Подключиться" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/backToServersButton" android:text="Выбрать другой сервер" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/connectedContainer" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/connectedStatus" android:text="Подключено" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/connectedServer" android:text="—" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/connectedProtocol" android:text="WireGuard" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/connectedDuration" android:text="00:00:00" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/connectedTrafficRx" android:text="↓ —" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/connectedTrafficTx" android:text="↑ —" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/disconnectButton" android:text="Отключиться" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
